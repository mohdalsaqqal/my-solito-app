{
  "$schema": "https://turbo.build/schema.json",

  "globalEnv": [
    "DATABASE_URL",
    "DIRECT_URL",
    "BETTER_AUTH_SECRET",
    "AUTH_SESSION_SECRET",
    "TRUSTED_REQUEST_BYPASS_SECRET",
    "APP_ENV",
    "REQUIRE_PRODUCTION_AUTH",
    "USE_MOCK",
    "NODE_ENV",
    "PREVIEW_TOKEN_SECRET",
    "AUTH_COOKIE_SECURE",
    "STRICT_PROVIDER_READINESS",
    "RATE_LIMIT_STORE",
    "USE_MEILISEARCH",
    "USE_EMAIL_NOTIFICATIONS",
    "USE_EXPO_PUSH",
    "USE_TRANSLATION_MOCK",
    "BETTER_AUTH_URL",
    "BETTER_AUTH_TRUSTED_ORIGINS",
    "EXPO_PUBLIC_API_BASE_URL"
  ],

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "NEXT_PUBLIC_VERCEL_ENV",
        "NEXT_PUBLIC_SITE_URL"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "test": {
      "dependsOn": [],
      "outputs": []
    }
  }
}
