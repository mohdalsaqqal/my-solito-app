{
  "name": "solito-blank",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "!apps/strapi"
  ],
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@react-native-reusables/cli": "^0.6.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "c8": "^10.1.2",
    "eslint": "^8.21.0",
    "i18next-parser": "^9.3.0",
    "tailwindcss": "^4.1.13",
    "turbo": "^2.4.4",
    "typescript": "5.9.3",
    "uniwind": "^1.3.2"
  },
  "scripts": {
    "expo": "cd apps/expo && yarn start",
    "native": "cd apps/expo && yarn start",
    "web": "cd apps/next && yarn dev:stable",
    "web:prod": "cd apps/next && yarn build && yarn start",
    "web:dev": "cd apps/next && yarn dev:stable",
    "web:dev:raw": "cd apps/next && yarn dev --webpack",
    "tokens:css:generate": "node scripts/generate-css-token-bridge.mjs",
    "tokens:css:check": "node scripts/generate-css-token-bridge.mjs --check",
    "data:generate:mock-erp-products": "node scripts/generate-mock-erp-products.mjs",
    "guard:checks": "node scripts/guard-checks.mjs",
    "guard:hygiene": "node scripts/guard-hygiene.mjs",
    "guard:agent-docs": "node scripts/check-agent-docs.mjs",
    "verify:functional-storefront": "node scripts/verify-functional-storefront.mjs",
    "verify:functional-storefront:static": "node scripts/verify-functional-storefront.mjs --static-only",
    "verify:cms-lifecycle": "node scripts/verify-cms-lifecycle.mjs",
    "verify:pharmacist-browser": "node scripts/run-e2e-pharmacist.mjs",
    "verify:expo-functional": "node scripts/verify-expo-functional.mjs",
    "verify:retention-consultation": "node scripts/verify-retention-consultation.mjs",
    "verify:shopify-scope": "node scripts/smoke-shopify-adapter-scope.mjs",
    "verify:postgresql-mapping": "node scripts/smoke-postgresql-adapter-mapping.mjs",
    "verify:meilisearch-adapter": "node scripts/smoke-meilisearch-adapter.mjs",
    "verify:delivery": "node scripts/verify-delivery.mjs",
    "verify:delivery:functional": "node scripts/verify-delivery.mjs --profile functional",
    "verify:delivery:full": "node scripts/verify-delivery.mjs --profile full",
    "test": "turbo run test",
    "i18n:extract": "i18next --config tools/i18n/i18next-parser.config.cjs",
    "i18n:crowdin:push": "node tools/i18n/crowdin-push.mjs",
    "i18n:crowdin:mt": "node tools/i18n/crowdin-mt.mjs",
    "i18n:crowdin:pull": "node tools/i18n/crowdin-pull.mjs",
    "i18n:types": "node tools/i18n/generate-key-types.mjs",
    "i18n:check": "node tools/i18n/check-i18n.mjs",
    "i18n:guard:hardcoded": "node tools/i18n/hardcoded-strings-check.mjs",
    "i18n:guard:baseline": "node tools/i18n/update-hardcoded-baseline.mjs",
    "codex:route": "node .codex/router.js",
    "codex:test": "node --test .codex/router.test.js",
    "codex:version-check": "node .codex/check-version.js",
    "codex:review": "node .codex/router.js --mode reviewer --run-guard \"review current changes\"",
    "codex:guard": "yarn codex:version-check && yarn guard:checks",
    "codex:fix": "node .codex/router.js --mode fix --run-guard \"fix guard or review findings\"",
    "inspector:sync": "node -e \"const fs=require('fs');fs.mkdirSync('apps/next/public/dev',{recursive:true});fs.copyFileSync('tools/inspector/ect-inspector.js','apps/next/public/dev/ect-inspector.js');console.log('synced public inspector');\"",
    "inspector:sync-extension": "node -e \"const fs=require('fs');fs.mkdirSync('tools/inspector/extension',{recursive:true});fs.copyFileSync('tools/inspector/ect-inspector.js','tools/inspector/extension/ect-inspector.js');console.log('synced extension inspector');\"",
    "inspector:sync-all": "yarn inspector:sync && yarn inspector:sync-extension",
    "e2e": "playwright test",
    "e2e:a11y": "node scripts/run-e2e-a11y.mjs",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report test-results/html-report",
    "verify:audit-remediation": "yarn guard:checks && yarn tsc -p apps/next/tsconfig.json --noEmit --incremental false && yarn --cwd apps/next test:api && yarn e2e:a11y"
  },
  "packageManager": "yarn@4.13.0",
  "eslintConfig": {
    "extends": "next",
    "settings": {
      "next": {
        "rootDir": "apps/next/"
      }
    },
    "root": true
  },
  "prettier": {
    "semi": false,
    "useTabs": false,
    "tabWidth": 2,
    "singleQuote": true
  }
}
