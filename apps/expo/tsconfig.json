{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": "../..",
    "paths": {
      "@real/app": ["./packages/app/index.ts"],
      "@real/app/*": ["./packages/app/*"],
      "@real/ui": ["./packages/ui/index.ts"],
      "@real/ui/*": ["./packages/ui/*"],
      "@real/tokens": ["./packages/tokens/index.ts"],
      "@real/tokens/*": ["./packages/tokens/*"],
      "@real/providers": ["./packages/providers/index.ts"],
      "@real/providers/*": ["./packages/providers/*"],
      "@real/adapters": ["./packages/adapters/index.ts"],
      "@real/adapters/*": ["./packages/adapters/*"]
    }
  },
  "include": [
    "*.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "../../packages/app/**/*.ts",
    "../../packages/app/**/*.tsx",
    "../../packages/ui/**/*.ts",
    "../../packages/ui/**/*.tsx",
    "../../packages/tokens/**/*.ts",
    "../../packages/providers/contracts/**/*.ts",
    "../../packages/providers/contracts.ts"
  ],
  "exclude": [
    "../../packages/**/__tests__/**",
    "../../packages/**/*.test.ts",
    "../../packages/**/*.test.tsx",
    "../../packages/adapters/**",
    "../../packages/ui/_reference/**"
  ]
}
