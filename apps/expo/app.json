{
  "expo": {
    "name": "solito-blank",
    "slug": "solito-blank",
    "version": "1.0.0",
    "scheme": "solito-blank",
    "platforms": ["ios", "android"],
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.solito.blank"
    },
    "android": {
      "package": "com.solito.blank"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#111111",
          "defaultChannel": "orders"
        }
      ]
    ],
    "newArchEnabled": true,
    "experiments": {
      "reactCanary": true
    }
  }
}
