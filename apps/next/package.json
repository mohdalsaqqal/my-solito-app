{
  "name": "next-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=8192 next dev",
    "predev": "prisma generate --schema prisma/schema.prisma",
    "dev:stable": "NODE_OPTIONS=--max-old-space-size=8192 node scripts/dev-stable.mjs",
    "prebuild": "prisma generate --schema prisma/schema.prisma && prisma migrate deploy --schema prisma/schema.prisma",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 next build",
    "start": "next start",
    "lint": "next lint",
    "test": "yarn test:api",
    "test:api": "node scripts/run-api-tests.mjs",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@prisma/client": "6.5.0",
    "@real/app": "*",
    "@sentry/nextjs": "^10.51.0",
    "better-auth": "^1.6.2",
    "next": "16.2.1",
    "raf": "3.4.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-native": "0.81.4",
    "react-native-reanimated": "4.1.3",
    "react-native-web": "0.19.13",
    "react-native-worklets": "0.5.1",
    "zod": "3.24.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.2.1",
    "@types/node": "24.3.0",
    "@types/supertest": "6.0.3",
    "bcryptjs": "^3.0.3",
    "eslint-config-next": "16.2.1",
    "prisma": "6.5.0",
    "supertest": "7.1.1",
    "tsx": "4.20.5"
  }
}
