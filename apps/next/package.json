{
  "name": "next-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=8192 next dev",
    "dev:stable": "NODE_OPTIONS=--max-old-space-size=8192 node scripts/dev-stable.mjs",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 next build",
    "start": "next start",
    "lint": "next lint",
    "test": "yarn test:api",
    "test:api": "node --max-old-space-size=4096 ../../node_modules/tsx/dist/cli.mjs --test --test-concurrency=1 'app/api/**/*.test.ts' 'server/services/**/*.test.ts'",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "6.5.0",
    "@real/app": "*",
    "next": "16.2.1",
    "raf": "3.4.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-native": "0.81.4",
    "react-native-reanimated": "4.1.3",
    "react-native-web": "0.19.13",
    "react-native-worklets": "0.5.1",
    "zod": "3.24.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.2.1",
    "@types/node": "24.3.0",
    "@types/supertest": "6.0.3",
    "eslint-config-next": "16.2.1",
    "prisma": "6.5.0",
    "supertest": "7.1.1",
    "tsx": "4.20.5"
  }
}
