{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@real/app": [
        "../../packages/app/index.ts"
      ],
      "@real/app/*": [
        "../../packages/app/*"
      ],
      "@real/ui": [
        "../../packages/ui/index.ts"
      ],
      "@real/ui/*": [
        "../../packages/ui/*"
      ],
      "@real/tokens": [
        "../../packages/tokens/index.ts"
      ],
      "@real/tokens/*": [
        "../../packages/tokens/*"
      ],
      "@real/providers": [
        "../../packages/providers/index.ts"
      ],
      "@real/providers/*": [
        "../../packages/providers/*"
      ],
      "@real/adapters": [
        "../../packages/adapters/index.ts"
      ],
      "@real/adapters/*": [
        "../../packages/adapters/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "app-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "next.config.mjs",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
