generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameEn    String
  nameAr    String
  parentId  String?
  image     String?
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  parent    Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")

  @@index([parentId])
  @@index([sortOrder])
}

model Brand {
  id            String   @id @default(cuid())
  slug          String   @unique
  nameEn        String
  nameAr        String
  logo          String?
  descriptionEn String?
  descriptionAr String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ProductQuery {
  slug       String   @id
  filtersJson Json
  active     Boolean  @default(true)
  titleEn    String
  titleAr    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum ReleaseEnvironment {
  staging
  production
}

enum ReleaseStatus {
  draft
  published
}

enum ReleaseBlockType {
  hero
  product_slider
  brand_promo
  promo_strip
}

enum AppAuthRole {
  customer
  pharmacist
  admin
  marketing
  catalog
  support
  ops
}

model Release {
  id          String             @id @default(cuid())
  tenantId    String             @default("default")
  environment ReleaseEnvironment
  status      ReleaseStatus      @default(draft)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  blocks      ReleaseBlock[]

  @@index([tenantId])
  @@index([environment, status])
}

model ReleaseBlock {
  id          String           @id @default(cuid())
  tenantId    String           @default("default")
  releaseId   String
  position    Int
  type        ReleaseBlockType
  payloadJson Json
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  release     Release          @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([releaseId, position])
}

model Promotion {
  id             String   @id @default(cuid())
  tenantId       String   @default("default")
  code           String?
  nameEn         String
  nameAr         String
  isActive       Boolean  @default(true)
  startAt        DateTime
  endAt          DateTime
  priority       Int      @default(0)
  conditionsJson Json
  rewardsJson    Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([isActive, startAt, endAt])
  @@index([priority])
}

model PricingQuote {
  id        String   @id @default(cuid())
  tenantId  String   @default("default")
  userId    String?
  cartHash  String
  quoteJson Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([cartHash])
  @@index([userId])
  @@index([expiresAt])
}

model User {
  id            String             @id
  name          String
  email         String             @unique
  emailVerified Boolean            @default(false)
  image         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  accounts      Account[]
  sessions      Session[]
  roleMapping   AppAuthRoleMapping?
  tenantUsers   TenantUser[]

  @@map("user")
}

model Tenant {
  id          String       @id
  name        String
  slug        String       @unique
  status      String       @default("active")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenantUsers TenantUser[]

  @@map("tenant")
}

model TenantUser {
  id        String      @id @default(cuid())
  tenantId  String
  userId    String
  role      AppAuthRole @default(customer)
  status    String      @default("active")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, role])
  @@map("tenant_user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String   @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model AppAuthRoleMapping {
  id             String      @id @default(cuid())
  userId         String      @unique
  role           AppAuthRole @default(customer)
  updatedByEmail String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("app_auth_role_mapping")
}

// ============================================================================
// CMS Entities — replaces JSON file stores in .data/
// ============================================================================

// Site-wide configuration (singleton per tenant: @@unique([tenantId]))
model CmsSiteConfig {
  id                      String   @id @default("default")
  tenantId                String   @default("default")
  brandingEnLogoUrl       String   @default("")
  brandingEnLogoAlt       String   @default("Real Cosmetics")
  brandingEnLogoSize      String   @default("md")
  brandingArLogoUrl       String   @default("")
  brandingArLogoAlt       String   @default("ريال كوزمتكس")
  brandingArLogoSize      String   @default("md")
  topBarMessageEn         String   @default("")
  topBarMessageAr         String   @default("")
  topBarCtaLabelEn        String   @default("")
  topBarCtaLabelAr        String   @default("")
  topBarCtaHref           String   @default("")
  footerNewsletterTitleEn String   @default("")
  footerNewsletterTitleAr String   @default("")
  footerLegalEn           String   @default("")
  footerLegalAr           String   @default("")
  searchPanelTitleEn      String   @default("")
  searchPanelTitleAr      String   @default("")
  updatedAt               DateTime @updatedAt

  @@index([tenantId])
}

// Ticker settings (singleton per tenant)
model CmsTickerSettings {
  id        String   @id @default("default")
  tenantId  String   @default("default")
  speedMs   Int      @default(4000)
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// Scrolling ticker messages
model CmsTickerItem {
  id        String   @id @default(cuid())
  tenantId  String   @default("default")
  messageEn String
  messageAr String
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([order])
}

// Education banners
model CmsEducationBanner {
  id         String   @id @default(cuid())
  tenantId   String   @default("default")
  titleEn    String   @default("")
  titleAr    String   @default("")
  bodyEn     String   @default("")
  bodyAr     String   @default("")
  targetPage String   @default("")
  active     Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
  @@index([order])
}

// User-generated content gallery items
model CmsUgcItem {
  id           String   @id @default(cuid())
  tenantId     String   @default("default")
  imageUrl     String
  caption      String
  sourceHandle String   @default("")
  active       Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@index([order])
}

// Toggle overrides (admin control toggles)
model CmsToggleOverride {
  id               String   @id // toggle id like "free_shipping", "loyalty_program"
  tenantId         String   @default("default")
  enabled          Boolean  @default(false)
  updatedAt        DateTime @updatedAt
  updatedByUserId  String   @default("")
  updatedByEmail   String   @default("")

  @@index([tenantId])
}

// Brand spotlights (homepage marketing blocks)
model CmsBrandSpotlight {
  id              String   @id @default(cuid())
  tenantId        String   @default("default")
  position        Int      @default(0)
  spotlightJson   Json     // Full CMS spotlight object
  updatedAt       DateTime @updatedAt
  updatedByUserId String   @default("")
  updatedByEmail  String   @default("")

  @@index([tenantId])
  @@index([position])
}

// Offer banners (homepage promo banners)
model CmsOfferBanner {
  id              String   @id @default(cuid())
  tenantId        String   @default("default")
  position        Int      @default(0)
  bannerJson      Json     // Full CMS banner object
  updatedAt       DateTime @updatedAt
  updatedByUserId String   @default("")
  updatedByEmail  String   @default("")

  @@index([tenantId])
  @@index([position])
}

// Audit log for admin operations
model CmsAuditLog {
  id           String   @id @default(cuid())
  tenantId     String   @default("default")
  type         String   // "TOGGLE_CHANGED", "BRAND_SPOTLIGHT_CREATED", etc.
  targetId     String
  actorUserId  String   @default("")
  actorEmail   String   @default("")
  changes      Json     // { field: { from, to } }
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([createdAt(sort: Desc)])
  @@index([type])
}

// Homepage merchandising — CMS page blocks (release-scoped)
model CmsPageBlock {
  id          String   @id @default(cuid())
  tenantId    String   @default("default")
  releaseId   String   // release environment reference
  position    Int      @default(0)
  blockType   String   // hero_carousel, promo_strip, flash_sale, etc.
  payloadJson Json     // full block payload
  locale      String   @default("en")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([releaseId, position])
  @@index([blockType])
}

// Homepage marketing rails
model CmsMarketingRail {
  id          String   @id @default(cuid())
  tenantId    String   @default("default")
  railId      String   // e.g. "best-items-month"
  enabled     Boolean  @default(true)
  titleEn     String
  titleAr     String
  querySource String   // best_sellers, new_arrivals, bundle_only
  queryLimit  Int      @default(12)
  querySortBy String   @default("price_desc")
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, railId])
  @@index([tenantId])
  @@index([position])
}

// Homepage campaign zones
model CmsCampaign {
  id            String   @id @default(cuid())
  tenantId      String   @default("default")
  campaignId    String   // e.g. "m-camp-hero-primary"
  enabled       Boolean  @default(true)
  zone          String   // home_hero_primary, home_flash_sale, shop_banner
  titleEn       String
  titleAr       String
  subtitleEn    String   @default("")
  subtitleAr    String   @default("")
  ctaLabelEn    String   @default("")
  ctaLabelAr    String   @default("")
  href          String   @default("")
  imageUrl      String   @default("")
  timerEndsAt   String   @default("")
  urgencyBadgeEn String  @default("")
  urgencyBadgeAr String  @default("")
  showTimer     Boolean  @default(false)
  showUrgency   Boolean  @default(false)
  position      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, campaignId])
  @@index([tenantId])
  @@index([zone])
  @@index([position])
}

// Homepage hero carousel cards
model CmsHeroCard {
  id            String   @id @default(cuid())
  tenantId      String   @default("default")
  cardId        String
  titleEn       String
  titleAr       String
  subtitleEn    String   @default("")
  subtitleAr    String   @default("")
  ctaLabelEn    String   @default("")
  ctaLabelAr    String   @default("")
  href          String   @default("")
  imageUrl      String   @default("")
  badgeLabelEn  String   @default("")
  badgeLabelAr  String   @default("")
  position      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, cardId])
  @@index([tenantId])
  @@index([position])
}

// Homepage editorial hotspots
model CmsEditorialHotspot {
  id            String   @id @default(cuid())
  tenantId      String   @default("default")
  enabled       Boolean  @default(true)
  titleEn       String
  titleAr       String
  subtitleEn    String   @default("")
  subtitleAr    String   @default("")
  ctaLabelEn    String   @default("")
  ctaLabelAr    String   @default("")
  href          String   @default("")
  imageUrl      String
  productIdsJson Json   @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

// Homepage newsletter CTA
model CmsNewsletterCta {
  id            String   @id @default(cuid())
  tenantId      String   @default("default")
  enabled       Boolean  @default(true)
  titleEn       String
  titleAr       String
  subtitleEn    String   @default("")
  subtitleAr    String   @default("")
  ctaLabelEn    String   @default("")
  ctaLabelAr    String   @default("")
  href          String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

// Homepage personalization settings
model CmsPersonalization {
  id              String   @id @default(cuid())
  tenantId        String   @default("default")
  enabled         Boolean  @default(true)
  mode            String   @default("rule-based")
  recommendedTitleEn String @default("Recommended for You")
  recommendedTitleAr String @default("موصى بها لك")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
}

// Homepage rail autoplay settings
model CmsRailAutoplay {
  id        String   @id @default(cuid())
  tenantId  String   @default("default")
  railKey   String   // hero, categories, newArrivals, featured, brandSpotlights
  enabled   Boolean  @default(true)
  autoplayMs Int     @default(4000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, railKey])
  @@index([tenantId])
}

// Featured campaign slot
model CmsFeaturedSlot {
  id            String   @id @default(cuid())
  tenantId      String   @default("default")
  enabled       Boolean  @default(true)
  titleEn       String
  titleAr       String
  subtitleEn    String   @default("")
  subtitleAr    String   @default("")
  ctaLabelEn    String   @default("")
  ctaLabelAr    String   @default("")
  href          String   @default("")
  imageUrl      String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

// Complete set (frequently bought together)
model CmsCompleteSet {
  id            String   @id @default(cuid())
  tenantId      String   @default("default")
  enabled       Boolean  @default(true)
  titleEn       String
  titleAr       String
  subtitleEn    String   @default("")
  subtitleAr    String   @default("")
  ctaLabelEn    String   @default("")
  ctaLabelAr    String   @default("")
  ctaHref       String   @default("")
  querySource   String   @default("bundle_only")
  queryLimit    Int      @default(8)
  querySortBy   String   @default("price_desc")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

model RateLimitBucket {
  tenantId  String   @default("default")
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([resetAt])
}

// ============================================================================
// Referral & Loyalty — Prisma-backed production storage
// ============================================================================

model ReferralProgram {
  id                         String   @id @default("default")
  tenantId                   String   @default("default")
  storeId                    String   @default("default")
  mode                       String   @default("two_way")
  accessMode                 String   @default("open")
  followerRewardType         String   @default("fixed_discount")
  followerRewardValue        Float    @default(0)
  followerRewardCurrency     String   @default("SAR")
  influencerRewardType       String   @default("fixed_discount")
  influencerRewardValue      Float    @default(0)
  influencerRewardCurrency   String   @default("SAR")
  attributionWindowDays      Int      @default(30)
  firstOrderOnly             Boolean  @default(true)
  allowStackingWithPromotions Boolean @default(false)
  minimumOrderAmount         Float    @default(0)
  minimumOrderCurrency       String   @default("SAR")
  updatedAt                  DateTime @updatedAt

  @@unique([tenantId, storeId])
  @@index([tenantId])
}

model ReferralProfile {
  id            String   @id @default(cuid())
  tenantId      String   @default("default")
  storeId       String   @default("default")
  userId        String
  userEmail     String
  actorType     String   @default("customer")
  code          String
  shareLink     String   @default("")
  approved      Boolean  @default(false)
  displayName   String   @default("")
  audienceCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, userId])
  @@unique([code])
  @@index([tenantId])
  @@index([storeId])
}

model ReferralLedgerEntry {
  id                   String   @id @default(cuid())
  tenantId             String   @default("default")
  storeId              String   @default("default")
  profileId            String
  referredUserId       String?
  orderId              String?
  code                 String
  status               String   @default("pending")
  currency             String   @default("SAR")
  subtotal             Float    @default(0)
  followerRewardValue  Float    @default(0)
  influencerRewardValue Float   @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([tenantId])
  @@index([profileId])
  @@index([storeId])
  @@index([status])
}

// ============================================================================
// Admin — Prisma-backed user override storage
// ============================================================================

model AdminUserOverride {
  id                String   @id
  tenantId          String   @default("default")
  role              String?
  status            String?
  permissionsJson   Json?
  domainPermissions Json?
  updatedByEmail    String?
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
}
