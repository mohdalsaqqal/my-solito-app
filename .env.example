# --- Provider Mock Toggle ---
# Set to 'false' to use real adapters (Odoo, Networks, etc.)
# WARNING: Leaving this as 'true' in production serves mock data to all users.
USE_MOCK=false

# Translation adapter mock (safe to keep true if using Crowdin-only flow)
USE_TRANSLATION_MOCK=true

CDN_PURGE_URL=
CDN_PURGE_SECRET=

# --- Auth Session ---
# MUST be set to a strong random string in production.
AUTH_SESSION_SECRET=CHANGE_ME_USE_A_STRONG_RANDOM_SECRET
# Better Auth uses this for session and token signing.
# In production/staging this should be at least 32 characters of high-entropy random data.
BETTER_AUTH_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated when multiple trusted origins are needed.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
REQUIRE_PRODUCTION_AUTH=true
AUTH_COOKIE_SECURE=true
# Optional OAuth providers. Configure only after the client chooses providers.
BETTER_AUTH_GOOGLE_CLIENT_ID=
BETTER_AUTH_GOOGLE_CLIENT_SECRET=
BETTER_AUTH_APPLE_CLIENT_ID=
BETTER_AUTH_APPLE_CLIENT_SECRET=

# --- Preview Token ---
PREVIEW_TOKEN_SECRET=CHANGE_ME_USE_A_STRONG_RANDOM_SECRET

CROWDIN_PROJECT_ID=
CROWDIN_TOKEN=
CROWDIN_MT_ENGINE_ID=

# --- Database ---
# NEVER use default credentials in production.
# For Neon/Vercel serverless runtime, use the pooled URL for DATABASE_URL
# and the direct URL for DIRECT_URL so Prisma migrations can run safely.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/real_commerce
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/real_commerce

# --- One-Time Admin Seed ---
# Set only while running `yarn seed:admin`, then remove from shell/session.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_USE_A_STRONG_ADMIN_PASSWORD
# Optional pharmacist bootstrap:
PHARMACIST_EMAIL=
PHARMACIST_PASSWORD=

# --- Rate Limiting ---
# Use 'memory' for local/test. Set to 'prisma' after applying the Prisma migration
# if you want auth and mutation rate limits to be shared across instances.
RATE_LIMIT_STORE=memory

NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=1
CHOKIDAR_INTERVAL=300
# NOTE (development only):
# For Expo Go on a real device, use your machine LAN IP (example: http://192.168.1.50:3000).
# Keep production values explicitly configured and do not rely on localhost fallback.

# --- Push Notifications ---
# Default is local mock notification delivery. Set USE_EXPO_PUSH=true after EAS
# project setup and push credentials are configured.
USE_EXPO_PUSH=false
EXPO_PUSH_ACCESS_TOKEN=
USE_EMAIL_NOTIFICATIONS=false
EMAIL_NOTIFICATION_ENDPOINT=https://email-provider.example.com/messages
EMAIL_NOTIFICATION_API_KEY=
EMAIL_NOTIFICATION_FROM=no-reply@example.com

# --- Odoo ERP Integration ---
# Set USE_MOCK=false to use real Odoo adapters instead of mock data
ODOO_BASE_URL=https://your-odoo-instance.example.com
ODOO_DB=your_database_name
ODOO_API_KEY=your_odoo_api_key

# --- Shopify Integration ---
# Set USE_MOCK=false and configure these when using a Shopify merchant backend.
SHOPIFY_STORE_DOMAIN=client.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=your_shopify_admin_access_token
SHOPIFY_ADMIN_API_VERSION=2026-01
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret

# --- Custom PostgreSQL Merchant Backend ---
# Set USE_MOCK=false and configure these when the merchant exposes catalog/order
# data through a PostgreSQL database or read/write proxy.
MERCHANT_POSTGRES_URL=postgresql://merchant_user:merchant_password@merchant-db.example.com:5432/merchant
MERCHANT_POSTGRES_SCHEMA=public
MERCHANT_POSTGRES_SSL=true
MERCHANT_POSTGRES_READONLY=true

# --- Meilisearch Search ---
# Set USE_MEILISEARCH=true to route SearchProvider through Meilisearch.
USE_MEILISEARCH=false
MEILISEARCH_HOST=https://search.example.com
MEILISEARCH_API_KEY=your_meilisearch_api_key
# Supports {tenantId} and {storeId} placeholders for isolated indexes.
MEILISEARCH_PRODUCTS_INDEX=products_{tenantId}

# --- Networks Payment Gateway ---
# Set USE_NETWORKS=false to use real Networks payment instead of mock
NETWORKS_BASE_URL=https://api.networks.sa
NETWORKS_API_KEY=your_merchant_api_key
NETWORKS_WEBHOOK_SECRET=your_webhook_hmac_secret
NETWORKS_MERCHANT_ID=your_merchant_id

# --- Custom Payment Gateway ---
# Default is mock payment. Set USE_CUSTOM_PAYMENT=false plus these values to route
# checkout payment intents through packages/adapters/custom-payment.
USE_CUSTOM_PAYMENT=true
CUSTOM_PAYMENT_BASE_URL=https://payments.example.com
CUSTOM_PAYMENT_API_KEY=your_custom_payment_api_key
CUSTOM_PAYMENT_WEBHOOK_SECRET=your_custom_payment_webhook_secret
CUSTOM_PAYMENT_PROVIDER_NAME=custom_gateway
# Give this app route to the payment vendor for settlement events:
# https://your-store.example.com/api/payments/custom/webhook

# --- Sentry Error Tracking ---
# Add the DSN from your Sentry project to enable error monitoring.
# Both SENTRY_DSN (server) and NEXT_PUBLIC_SENTRY_DSN (client) are supported.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Enable HSTS only after confirming the production domain is fully HTTPS-served.
# Prematurely enabling HSTS can lock users out of the site if HTTPS is misconfigured.
# ENABLE_HSTS=true

# --- Provider Readiness Gate ---
# When 'true', throws at startup if core domains (product, category, brand, order)
# are backed by mock adapters in production/staging.
STRICT_PROVIDER_READINESS=true
