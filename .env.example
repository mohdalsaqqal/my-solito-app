# --- Provider Mock Toggle ---
# Set to 'false' to use real adapters (Odoo, Networks, etc.)
# WARNING: Leaving this as 'true' in production serves mock data to all users.
USE_MOCK=false

# Translation adapter mock (safe to keep true if using Crowdin-only flow)
USE_TRANSLATION_MOCK=true

CDN_PURGE_URL=
CDN_PURGE_SECRET=

# --- Auth Session ---
# MUST be set to a strong random string in production.
AUTH_SESSION_SECRET=CHANGE_ME_USE_A_STRONG_RANDOM_SECRET
# Better Auth uses this for session and token signing.
# In production/staging this should be at least 32 characters of high-entropy random data.
BETTER_AUTH_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated when multiple trusted origins are needed.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
REQUIRE_PRODUCTION_AUTH=true
AUTH_COOKIE_SECURE=true

# --- Preview Token ---
PREVIEW_TOKEN_SECRET=CHANGE_ME_USE_A_STRONG_RANDOM_SECRET

CROWDIN_PROJECT_ID=
CROWDIN_TOKEN=
CROWDIN_MT_ENGINE_ID=

# --- Database ---
# NEVER use default credentials in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/real_commerce

# --- Rate Limiting ---
# Use 'memory' for local/test. Set to 'prisma' after applying the Prisma migration
# if you want auth and mutation rate limits to be shared across instances.
RATE_LIMIT_STORE=memory

NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=1
CHOKIDAR_INTERVAL=300
# NOTE (development only):
# For Expo Go on a real device, use your machine LAN IP (example: http://192.168.1.50:3000).
# Keep production values explicitly configured and do not rely on localhost fallback.

# --- Odoo ERP Integration ---
# Set USE_MOCK=false to use real Odoo adapters instead of mock data
ODOO_BASE_URL=https://your-odoo-instance.example.com
ODOO_DB=your_database_name
ODOO_API_KEY=your_odoo_api_key

# --- Networks Payment Gateway ---
# Set USE_NETWORKS=false to use real Networks payment instead of mock
NETWORKS_BASE_URL=https://api.networks.sa
NETWORKS_API_KEY=your_merchant_api_key
NETWORKS_WEBHOOK_SECRET=your_webhook_hmac_secret
NETWORKS_MERCHANT_ID=your_merchant_id

# --- Provider Readiness Gate ---
# When 'true', throws at startup if core domains (product, category, brand, order)
# are backed by mock adapters in production/staging.
STRICT_PROVIDER_READINESS=true
